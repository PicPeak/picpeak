# Backend Environment Variables Example
# Copy this file to .env and update with your values

# Application
NODE_ENV=production
PORT=3001

# Security
# Generate a unique value before starting: openssl rand -hex 32
# Never reuse a value from documentation. Startup rejects unset/short/example keys.
JWT_SECRET=

# Encrypts invitation, password-reset, and temporary-password email variables
# while they wait in email_queue. Defaults to JWT_SECRET. Keep it stable while
# such mail is pending; changing or losing it makes those queued rows fail
# closed. Set a dedicated 32+ character value to decouple it from JWT rotation.
# Generate with: openssl rand -hex 32
#EMAIL_QUEUE_ENCRYPTION_KEY=

# Admin 2FA (TOTP) secret encryption key — OPTIONAL.
# Admin authenticator secrets are encrypted at rest (AES-256-GCM). By default
# the key is derived from JWT_SECRET, so you do NOT need to set this. Set it
# only if you want the MFA encryption key decoupled from JWT_SECRET (e.g. so
# rotating JWT_SECRET doesn't invalidate enrolled authenticators). If you set
# it, changing/losing it makes existing 2FA secrets undecryptable — recover
# with: docker compose exec backend node scripts/reset-admin-mfa.js --all --yes
# Generate with: openssl rand -base64 32
#MFA_ENCRYPTION_KEY=

# Auth cookie Secure flag
#   unset  - default: 'auto' in production, false in development/test
#   true   - always set Secure (HTTPS-only cookies; breaks plain-HTTP access —
#            login appears to succeed but the browser silently drops the
#            cookie, leaving you in a redirect loop. Only set this if you
#            ALWAYS reach the site via HTTPS)
#   false  - never set Secure (allows HTTP; cookies not protected on HTTPS)
#   auto   - decide per request: Secure on HTTPS, not on HTTP. The default
#            in production, so a plain-HTTP install can still log in.
# Also accepted: 1/yes/on (true) and 0/no/off (false). Any other value is
# treated as auto and logged once at startup.
#
# When you'd set this explicitly:
#   - COOKIE_SECURE=true → recommended once the site is only ever reached
#     over HTTPS.
#   - COOKIE_SECURE=false → you intentionally only ever serve over HTTP and
#     accept that session cookies cross the network in plaintext.
#   - COOKIE_SECURE=auto → the same hostname is intentionally served over both
#     HTTP and HTTPS and the trusted proxy supplies X-Forwarded-Proto.
#
# Requirements for 'auto' mode to detect HTTPS correctly:
#   1. Your reverse proxy MUST send X-Forwarded-Proto: https on HTTPS
#      requests. Standard configs for NPM/Traefik/Caddy do this by default.
#   2. The proxy must be inside the TRUST_PROXY boundary (see below).
# COOKIE_SECURE=auto

# Cookie SameSite attribute (Lax | Strict | None). Default: Lax
# COOKIE_SAMESITE=Lax

# Cookie Domain — set this if serving auth cookies across subdomains.
# Leave unset for same-origin setups.
# COOKIE_DOMAIN=.example.com

# Address the Node process binds. Unset binds every interface. Recommended
# when the reverse proxy runs on this host:
# LISTEN_HOST=127.0.0.1
# Unset keeps the legacy trust in loopback and every private-range address
# (compatibility; logs a warning at startup). Recommended: the exact number of
# reverse-proxy hops, or the narrowest boundary (loopback for local Caddy).
# Express accepts false/true, a hop count, subnet names, CIDRs, or comma lists.
# TRUST_PROXY=loopback
# Enable only when this origin is always reached through HTTPS.
# ENABLE_HSTS=false

# URLs (adjust for your domain)
ADMIN_URL=https://photos.example.com
FRONTEND_URL=https://photos.example.com
BACKEND_URL=https://photos.example.com  # Or https://api.photos.example.com if separate

# API URL for email assets (logos, images in emails)
# This must be the publicly accessible URL where recipients can load images
# If not set, defaults to http://localhost:3001 which will break images in production emails
API_URL=https://photos.example.com/api

# Integration network policy
# Explicit exceptions for self-hosted analytics/OIDC on private networks.
# Exact origins, including scheme and non-default port; no paths or wildcards.
# Link-local/metadata destinations remain blocked even if listed here.
#INTEGRATION_PRIVATE_ORIGINS=http://umami:3000,https://idp.internal

# Database Configuration
DATABASE_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=picpeak
DB_PASSWORD=your-secure-database-password-change-this

# TLS towards PostgreSQL. DB_SSL=true verifies the certificate AND hostname
# by default, for the app, startup checks, backups and restores. Private or
# self-signed certificates require DB_SSL_CA=/path/to/ca.pem (or PEM text).
# Mount CA files read-only inside the container and use that container path.
# DB_SSL=false is for trusted local networks / the bundled non-TLS database.
# DB_SSL_REJECT_UNAUTHORIZED=false explicitly accepts ANY certificate:
# insecure compatibility override only; prefer configuring the correct CA.
# DB_SSL=false
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=
# DB_SSL_SERVERNAME is the certificate name when it is not DB_HOST (an IP or
# a compose alias). The app verifies that name. psql/pg_dump verify it too for
# an IP DB_HOST; for a DNS DB_HOST they verify the CA chain only (libpq
# sslmode=verify-ca), so pair it with DB_SSL_CA.
# DB_SSL_SERVERNAME=
DB_NAME=picpeak

# Email Configuration (Examples for common providers)
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# Mail sockets revalidate all DNS answers on each connection and keep hostname
# TLS verification. Private mail servers require an exact deployment approval:
# MAIL_PRIVATE_ENDPOINTS=smtp://mailhog:1025,imap://mail.internal:993
# The SMTP_HOST/SMTP_PORT pair set in this environment is approved as is.
# No UI setting can add approvals; metadata/link-local/reserved IPs stay blocked.
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password

# SendGrid example:
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@example.com

# Incoming-mail intake limits. The byte budgets bound the UNHANDLED backlog
# (messages being fetched plus captured documents nobody has booked yet), not
# the mail and documents you keep. Positive integers; see
# docs/incoming-mail-retention.md for all limits.
#EMAIL_INTAKE_INSTALLATION_BYTES=2147483648
#EMAIL_INTAKE_MAILBOX_BYTES=536870912
#EMAIL_INTAKE_SENDER_PER_HOUR=50
# Age-based deletion is OFF unless this is set: unset or 0 keeps every
# captured message and document. When set it must exceed the 90-day mailbox
# lookback (smaller values are raised to 91); archived mail and mail whose
# captured document still exists are never removed.
#EMAIL_INTAKE_RETENTION_DAYS=365
# Bare refusal/failure records (no sender, subject, body or document).
#EMAIL_INTAKE_METADATA_RETENTION_DAYS=7

# Storage Paths
# IMPORTANT: STORAGE_PATH must be set to avoid file path resolution issues
# Docker deployment:
STORAGE_PATH=/app/storage
EVENTS_PATH=/app/storage/events
ARCHIVE_PATH=/app/storage/events/archived

# Local development:
# STORAGE_PATH=./storage
# EVENTS_PATH=./storage/events
# ARCHIVE_PATH=./storage/events/archived

# File watcher (auto-import from the events/active folder, local storage only)
# Max photos processed in parallel by the watcher. The boot scan and bulk
# folder drops fire one handler per file — this bound keeps thumbnail
# generation from exhausting memory on small hosts. Default: 2
# FILE_WATCHER_CONCURRENCY=2

# External-media folder watcher (issue 1187). Reference-mode events can opt in
# per event (Event → Source Mode → "Watch folder for new files"); new images in
# the folder are then imported without pressing Import. Deleted files are
# never removed from the gallery.
# EXTERNAL_MEDIA_WATCH=true                    # global kill switch
# EXTERNAL_MEDIA_WATCH_POLLING=false           # true = stat-polling instead of inotify (NFS/SMB mounts)
# EXTERNAL_MEDIA_WATCH_POLL_INTERVAL_MS=5000
# EXTERNAL_MEDIA_WATCH_SWEEP_INTERVAL_MS=900000  # timer-driven pass over every watched event; 0 disables
# EXTERNAL_MEDIA_WATCH_DEBOUNCE_MS=10000       # quiet period after the last change before the import runs
# EXTERNAL_MEDIA_WATCH_STABILITY_MS=5000       # how long a file must stop growing before it counts as written

# ffmpeg/ffprobe/exiftool: an OPTIONAL process guard (limits per tool) and
# OPTIONAL kernel leases (fast crash recovery), both Linux-only and built by
# `npm run build:native`. Without them media is processed unguarded and
# interrupted work is recovered by age; the startup log says which is active.
# Full description in docs/MEDIA_PROCESSING.md and the root .env.example.
# MEDIA_PROCESS_HOST_ID=                  # default: /etc/machine-id, else generated in data/media-host-id
# MEDIA_PROCESS_LEASE_PATH=               # default: <temp dir>/picpeak-media-leases; must be on local disk
# MEDIA_PROCESS_CONCURRENCY=2             # probes, posters, RAW previews side by side
# MEDIA_PROCESS_QUEUE_LENGTH=256          # on-demand requests get 503 beyond this; the queues wait
# MEDIA_WORKER_MEMORY_MIB=2048            # guard: ffprobe, exiftool, poster frame
# MEDIA_FFMPEG_THREADS=                   # default: CPU count, at most 4
# MEDIA_PROBE_TIMEOUT_MS=30000
# MEDIA_RAW_TIMEOUT_MS=30000
# MEDIA_THUMBNAIL_TIMEOUT_MS=60000
# MEDIA_MAX_SNAPSHOT_MIB=1024
# MEDIA_MAX_VIDEO_PIXELS=40000000
# MEDIA_MAX_VIDEO_DIMENSION=16384
# MEDIA_MAX_VIDEO_STREAMS=16
# MEDIA_MAX_VIDEO_FPS=240
# MEDIA_MAX_INPUT_MIB=                    # these three: no limit unless set
# MEDIA_MAX_VIDEO_DURATION_SECONDS=
# MEDIA_MAX_VIDEO_PIXEL_FRAMES=

# Analytics Backend Configuration (OPTIONAL)
# Used for server-side tracking only
# Primary configuration should be done through Admin UI > Settings > Analytics
# UMAMI_URL=https://analytics.example.com
# UMAMI_WEBSITE_ID=b4d3c2a1-5678-90ab-cdef-1234567890ab

# Logging
LOG_LEVEL=info

# Per-network ceiling above the per-device protected-image rate limits, as a
# multiple of the device limit (default 20). Raise it for large events where
# many guests share one connection. Feedback has its own network budget.
# RATE_LIMIT_NETWORK_MULTIPLIER=20

# Optional product usage (#1110): disabled until explicit in-app consent.
# USAGE_COLLECTOR_URL=https://usage.picpeak.app
# Encryption material for the backend-only signing key (32+ characters).
# Defaults to JWT_SECRET; keep it stable until participation has been deleted.
# USAGE_ENCRYPTION_KEY=

## Limits on PUBLIC uploads only (gallery guests, PicTransfer file requests);
## photographer/admin/API/import uploads never count. Optional JSON overrides,
## see docs/PUBLIC_UPLOAD_LIMITS.md. Empty = defaults:
##   request body 95 MiB (never less than one file of the configured maximum)
##   gallery     50 GiB / 20000 files lifetime, 16 concurrent, 20 GiB per hour
##   guest       50 GiB / 20000 files lifetime, 16 concurrent, 20 GiB per hour (same as gallery)
##   transfer    50 GiB / 20000 files lifetime,  4 concurrent, 20 GiB per hour
##   account    500 GiB / 200000 files lifetime, 32 concurrent, 100 GiB per hour
##   deployment unlimited lifetime (free-disk headroom), 64 concurrent
## e.g. {"gallery":{"bytes":107374182400},"guest":{"requests":8}}
PUBLIC_UPLOAD_LIMITS_JSON=
## Authenticated uploads (admin UI, API token, resumable, PicTransfer files)
## are never rate-limited or charged; only what is in flight is bounded.
## Optional JSON overrides, same document. Empty = defaults:
##   stagedBytes      min(50 GiB, 25% of free space) held in staging at once
##   stagedFiles      50000
##   accountRequests  16 concurrent per uploading admin account
##   requests         64 concurrent per deployment
##   requestTimeoutMs 600000 (10 minutes per multipart request or chunk)
##   headroomBytes 512 MiB, headroomPercent 5, headroomFiles 1024
## e.g. {"stagedBytes":214748364800,"accountRequests":32}
ADMIN_UPLOAD_LIMITS_JSON=

# Backup over rsync/SSH: unknown/changed destination host keys are refused.
# Independently verify the server key and provision known_hosts before use;
# never trust ssh-keyscan output without checking its fingerprint separately.
# A readable (including read-only) file sits beside the configured SSH key
# unless set here. With neither, OpenSSH's pre-approved default trust applies.
# SSH config/proxies/aliases are ignored; connections use public vetted IPs
# on the SSH port from the backup settings (default 22; its known_hosts entry
# is then named [host]:port). No private-network opt-out or automatic
# trust-on-first-use.
# BACKUP_SSH_KNOWN_HOSTS=/app/data/ssh/known_hosts

# Analytics collection is data-only. HTTPS is mandatory in production.
# Explicit opt-in for an HTTP collector on a non-production backend only:
ANALYTICS_ALLOW_INSECURE_HTTP=false
